{
    "save_path": "results",
    "prepare": {
        "example_template": ["*/*/*"],
	"mix_input": {
        "calculation": "scf",
        "basis_type": "pw",
        "scf_thr_type": [2],
        "ks_solver": "dav_subspace",
        "pw_diag_ndim": [2],
        "pw_diag_nmax": [20],
        "pw_seed": [0],
        "kpar": [4]
	},
	"abacus2qe": 0,
	"abacus2vasp": 0,
	"abacus2cp2k": 0
    },
    "run_dft": [
        {
            "command": "OMP_NUM_THREADS=1 mpirun -n 16 abacus | tee out.log",
            "image": "registry.dp.tech/dptech/dp/native/prod-385/abacus-dpgen:1218-all",
            "bohrium": {
                "scass_type": "c32_m64_cpu",
                "job_type": "container",
                "platform": "ali"
            }
        }
    ],
    "post_dft": {
        "image": "registry.dp.tech/dptech/abacustest:latest",
        "metrics": {
            "dft_type": "abacus",
            "metrics_name": [
                "normal_end",
                "converge",
                "nkstot",
                "ibzk",
                "nbands",
                "nelec",
                "natom",
                "scf_steps",
                "total_time",
                "scf_time",
                "drho",
                "ds_mag",
                {
                    "scf_time/step": "{scf_time}/{scf_steps}",
		            "ks_solver": "{INPUT}['ks_solver']",
                    "volume_per_atom": "{volume}/{natom}",
                    "magz":"{ds_mag}[0][-1]",
                    "magz_force":"{ds_mag_force}[0][-1]"
                },
                "stress_time",
                "energy",
                "energy_per_atom",
                "force",
                "stress",
                "version"
            ],
            "save_file": "metrics.json"
        }
    }
}
