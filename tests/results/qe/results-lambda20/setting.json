{
    "save_path": "results-lambda20",
    "ABBREVIATION": {
        "INTEL": "registry.dp.tech/deepmodeling/abacus-intel:latest",
        "GNU": "registry.dp.tech/deepmodeling/abacus-gnu:latest",
        "QE": "registry.dp.tech/dptech/prod-471/vasp-qe-phonopy:20240102",
        "QE-new": "registry.dp.tech/dptech/dp/native/prod-256043/complete-quantum-expresso:20250513",
        "VASP": "registry.dp.tech/dptech/vasp:5.4.4",
        "LTS": "registry.dp.tech/dptech/abacus-stable:LTSv3.10"
    },
    "_COMMANDS": {
        "ABACUS": "OMP_NUM_THREADS=1 mpirun -n 16 abacus | tee out.log ",
        "QE": "mpirun -np 16 pw.x -i input | tee out.log && rm -rf pwscf.save ",
        "VASP": "source /opt/intel/oneapi/setvars.sh && ulimit -s unlimited  && mpirun -n 16 vasp_std | tee out.log"
    },
    "prepare": {
        "ifrun": false,
        "example_template": [
            "angle*"
        ],
        "link_example_template_extra_files": false,
        "abacus2qe": 1,
        "qe_setting": {
            "version": 7.0,
            "system": {
                "constrained_magnetization": "atomic direction"
            }
        },
        "pert_stru": {
            "pert_number": 0,
            "cell_pert_frac": 0.01,
            "atom_pert_dist": 0.01,
            "atom_pert_mode": "normal",
            "mag_rotate_angle": null,
            "mag_tilt_angle": null,
            "mag_norm_dist": null
        }
    },
    "run_dft": [
        {
            "example": [
                "angle45.00",
                "angle90.00",
                "angle135.00"
            ],
            "command": "mpirun -np 16 pw.x -i input | tee out.log && rm -rf pwscf.save",
            "image": "registry.dp.tech/dptech/prod-471/vasp-qe-phonopy:20240102",
            "bohrium": {
                "scass_type": "c32_m64_cpu",
                "job_type": "container",
                "platform": "ali"
            }
        }
    ],
    "post_dft": {
        "ifrun": false,
        "image": "registry.dp.tech/dptech/abacustest:latest",
        "metrics": {
            "dft_type": "abacus",
            "metrics_name": [
                "normal_end",
                "converge",
                "nkstot",
                "ibzk",
                "nbands",
                "nelec",
                "natom",
                "scf_steps",
                "total_time",
                "scf_time",
                {
                    "scf_time/step": "{scf_time}/{scf_steps}",
                    "ks_solver": "{INPUT}['ks_solver']"
                },
                "stress_time",
                "energy",
                "energy_per_atom",
                "force",
                "stress",
                "drho",
                "drho_last",
                "denergy_last",
                "version"
            ],
            "save_file": "metrics.json"
        }
    }
}