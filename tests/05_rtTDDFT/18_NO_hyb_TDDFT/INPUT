INPUT_PARAMETERS



# general information
calculation       md
esolver_type      tddft
md_type           nve
md_nstep          4
estep_per_md      2
td_dt             0.025
md_tfirst         -1


# rt-TDDFT parameters
td_vext           1 # add time-dependent external potential
td_vext_dire      3 # direction along z
td_stype          2 # 2: hybrid gauge
td_ttype          3 # Heaviside type potential
td_tstart         1 # the step electric field starts
td_tend           10 # the step electric field ends
td_heavi_t0       3
td_heavi_amp      0.05


# print out current information
out_current       1


suffix            autotest
pseudo_dir        ../../PP_ORB
orbital_dir       ../../PP_ORB
basis_type        lcao
gamma_only        0


# electronic structure calculations
ecutwfc           20
scf_nmax          100
scf_thr           1e-8


# charge mixing
mixing_type       broyden
mixing_beta       0.7
mixing_gg0        0.0

md_dt             0.05
init_vel          1
symmetry          -1
md_dumpfreq       1
out_vecpot        1
