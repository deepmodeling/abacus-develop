INPUT_PARAMETERS
suffix            autotest
pseudo_dir        ../../PP_ORB
orbital_dir       ../../PP_ORB
calculation       md
esolver_type      tddft
basis_type        lcao
gamma_only        0
symmetry          -1
nbands            2
ecutwfc           20

scf_thr           1e-8
scf_nmax          100
mixing_type       broyden
mixing_beta       0.7
mixing_gg0        0.0

md_type           nve
md_nstep          2
estep_per_md      1
md_dt             0.05
td_dt             0.05
init_vel          1
# Keep the supplied sub-roundoff velocity rather than rescaling to zero.
md_tfirst         -1
md_dumpfreq       1
md_restartfreq    1

# Keep the early-time fields weak to preserve the boundary regression.
td_vext           1
td_vext_dire      2 3
td_stype          0
td_ttype          2*0
td_tstart         0
td_tend           2
td_lcut1          0.05
td_lcut2          0.95
td_gauss_freq     1.164656 0.029116
td_gauss_amp      2.0 5.0
td_gauss_phase    2*0.0
td_gauss_t0       2*70
td_gauss_sigma    2*0.5
