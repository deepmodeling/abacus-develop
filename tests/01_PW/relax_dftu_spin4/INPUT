INPUT_PARAMETERS
suffix          autotest
calculation     relax
relax_nmax      2
basis_type      pw
device          cpu

# plane wave
noncolin        1
nspin           4
ecutwfc         10
gamma_only      0
scf_thr         1.0e-7
scf_nmax        30
out_chg         0
out_occ_mat     1

# smearing
smearing_method gaussian
smearing_sigma  0.01

# charge mixing
mixing_type     broyden
mixing_beta     0.4
ks_solver       dav_subspace
symmetry        0

# DFT+U parameters
dft_plus_u      1
orbital_corr    2
hubbard_u       5.0
onsite_radius   3.0

init_occ_mat    2
read_file_dir   .

out_freq_elec   1
out_freq_ion    2

kpar            1
pseudo_dir      ../../PP_ORB/
orbital_dir     ../../PP_ORB/
pw_seed         1

out_stru        1
cal_force       1
cal_stress      1
