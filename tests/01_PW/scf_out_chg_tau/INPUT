INPUT_PARAMETERS 
#Parameters (1.General)
suffix            autotest
calculation       scf

nbands            6
symmetry          0
pseudo_dir        ../../PP_ORB

#Parameters (2.Iteration)
ecutwfc           20
# Resolve both charge and kinetic-energy density at the existing cube tolerances.
scf_thr_type      2
scf_thr           1e-9
scf_nmax          200
kpar              2

out_chg           1 12
dft_functional    scan
pw_diag_thr       1e-12
pw_diag_nmax      200
diago_smooth_ethr false

#Parameters (3.Basis)
basis_type        pw

#Parameters (4.Smearing)
smearing_method   gauss
smearing_sigma    0.002

#Parameters (5.Mixing)
mixing_type       plain
mixing_beta       0.7
mixing_gg0        0.0
