INPUT_PARAMETERS 
#Parameters (1.General)
suffix            autotest
calculation       scf
init_wfc          random

symmetry          1
pseudo_dir        ../../PP_ORB

#Parameters (2.Iteration)
ecutwfc           5
scf_thr           1e-14
scf_nmax          100
#Parameters (3.Basis)
basis_type        pw

#Parameters (4.Smearing)
smearing_method   gauss
smearing_sigma    0.002

#Parameters (5.Mixing)
mixing_type       broyden
mixing_beta       0.7

dft_functional    XC_GGA_X_PBE+XC_GGA_C_PBE

cal_force         1
cal_stress        1

pw_seed           1
pw_diag_nmax       200
pw_diag_thr_max       1e-12
