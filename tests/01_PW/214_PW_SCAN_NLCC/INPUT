INPUT_PARAMETERS 
#Parameters (1.General)
suffix            autotest
calculation       scf
kpar              2
init_wfc          random

pseudo_dir        ../../PP_ORB

#Parameters (2.Iteration)
ecutwfc           50
# Tight real-space convergence stabilizes the energy and stress reference.
scf_thr_type      2
scf_thr           1e-9
scf_nmax          200
pw_diag_thr       1e-12
pw_diag_nmax      200
diago_smooth_ethr false

dft_functional    scan

#Parameters (3.Basis)
basis_type        pw

#Parameters (4.Smearing)
smearing_method   gauss
smearing_sigma    0.002

#Parameters (5.Mixing)
mixing_type       broyden
mixing_beta       0.7

cal_force         1
cal_stress        1

mixing_tau        1

pw_seed           1
