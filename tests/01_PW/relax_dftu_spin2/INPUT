INPUT_PARAMETERS

# general
suffix          autotest
calculation     relax
relax_nmax      3
basis_type      pw
device          cpu

# plane wave
nspin           2
ecutwfc         10
nbands          28
gamma_only      0
scf_thr 1e-10
scf_nmax 200
out_chg         0
out_occ_mat     1

# smearing
smearing_method gaussian
smearing_sigma  0.01

# charge mixing
mixing_type     broyden
mixing_beta     0.4
ks_solver       dav_subspace
symmetry        0

# DFT+U parameters
dft_plus_u      1
orbital_corr    2
hubbard_u       5.0
onsite_radius   3.0

init_occ_mat    2
read_file_dir   .
out_freq_elec   1
out_freq_ion    2

pseudo_dir      ../../PP_ORB/
orbital_dir     ../../PP_ORB/
pw_seed         1

cal_force       1
cal_stress      1

ecutrho 160

scf_thr_type 2

pw_diag_thr 1e-13

pw_diag_nmax 200

diago_smooth_ethr false

mixing_beta_mag 0.4
