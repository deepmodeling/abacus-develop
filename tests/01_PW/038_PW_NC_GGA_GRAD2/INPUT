INPUT_PARAMETERS

init_wfc          random
# PBE noncollinear GGA gradient regression
basis_type        pw
calculation       scf
noncolin          1
nspin             4
dft_functional    pbe
gga_grad          2
symmetry          0
cal_force         1
cal_stress        1

# plane wave and scf
ecutwfc           20
pw_seed           1
# Tight charge convergence stabilizes force/stress in the weak-moment limit.
scf_thr           1.0e-14
scf_nmax          150
out_chg           0

# smearing method
smearing_method   gaussian
smearing_sigma    0.02

# charge mixing method
mixing_type       broyden
mixing_beta       0.2
mixing_ndim       10

# diagonalization
# BPCG avoids Davidson near-null residual failures at this tight SCF threshold.
ks_solver         bpcg

# directories
pseudo_dir        ../../PP_ORB
suffix            autotest
