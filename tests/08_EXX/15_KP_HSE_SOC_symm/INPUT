INPUT_PARAMETERS
suffix		autotest
pseudo_dir        ../../PP_ORB
orbital_dir       ../../PP_ORB

calculation       scf
basis_type        lcao
gamma_only        0

ecutwfc           5
scf_thr           1e-2

smearing_method   gaussian
smearing_sigma    0.02
mixing_type       broyden
mixing_beta       0.15

symmetry          1
symmetry_prec     1e-5

nspin              4
lspinorb          1
cal_force         1
cal_stress        1

dft_functional    hse
exx_separate_loop 0
exx_hybrid_step 10
exx_pca_threshold 1e-1
exx_c_threshold 1e-1
exx_v_threshold 1
exx_dm_threshold 1e-2
