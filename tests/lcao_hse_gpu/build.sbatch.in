#!/usr/bin/env bash
#SBATCH --job-name=@JOB_NAME@
#SBATCH --partition=@PARTITION@
#SBATCH --qos=@QOS@
#SBATCH --account=abacus-group
#SBATCH --nodes=@NODES@
#SBATCH --ntasks=@TASKS@
#SBATCH --ntasks-per-node=@TASKS_PER_NODE@
#SBATCH --gpus-per-node=@GPUS_PER_NODE@
#SBATCH --time=@TIME@
#SBATCH --output=@OUTPUT@
#SBATCH --export=NIL

set -euo pipefail

export HOME=@HOME@
export USER=${SLURM_JOB_USER:?}
export LOGNAME=$USER
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

source @CONTROL@/modules.sh
module -t list 2>&1 | tee @RESULTS@/modules.txt
command -v cmake make mpicxx nvcc | tee @RESULTS@/tools.txt
nvidia-smi dmon -s pucvmte -o T > @RESULTS@/dmon-${SLURM_JOB_ID}.log &

# Header-only dependencies pinned by toolchain/scripts/package_versions.sh.
# Reuse the cereal installation settings from stage4/install_cereal.sh.
for package in libri libcomm cereal; do
    mkdir -p @BUILD@/hse-deps/$package
    tar -xzf @CONTROL@/$package.tar.gz --strip-components=1 -C @BUILD@/hse-deps/$package
done
cmake -S @BUILD@/hse-deps/cereal -B @BUILD@/hse-deps/cereal-build \
    -DCMAKE_INSTALL_PREFIX=@BUILD@/hse-deps/cereal-install \
    -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_DOC=OFF -DBUILD_SANDBOX=OFF \
    -DBUILD_TESTS=OFF -DTHREAD_SAFE=ON -DSKIP_PORTABILITY_TEST=ON \
    -DSKIP_PERFORMANCE_COMPARISON=ON -DJUST_INSTALL_CEREAL=ON
cmake --install @BUILD@/hse-deps/cereal-build

mkdir -p @BUILD@/ddla-source
 tar -xzf @CONTROL@/ddla.tar.gz --strip-components=1 -C @BUILD@/ddla-source
cmake -S @BUILD@/ddla-source -B @BUILD@/ddla-build \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES=70 \
    -DCUBLAS_LIBRARY=/opt/devtools/nvidia/cuda-12.9.1/lib64/libcublas.so \
    -DCURAND_LIBRARY=/opt/devtools/nvidia/cuda-12.9.1/lib64/libcurand.so \
    -DCUSOLVER_LIBRARY=/opt/devtools/nvidia/cuda-12.9.1/lib64/libcusolver.so \
    -DDDLA_USE_CUDA=ON -DDDLA_USE_CCL=OFF -DBUILD_TESTS=OFF \
    -DCMAKE_INSTALL_PREFIX=@INSTALL@/ddla
cmake --build @BUILD@/ddla-build --parallel 16
cmake --install @BUILD@/ddla-build
# LibRI adapter uses an obsolete DDLA diagnostic helper name.
sed -i 's/DEVICE_CHECK_RI/DEVICE_CHECK/g' @BUILD@/hse-deps/libri/include/RI/global/gpu/GPU_Backend.h
sed -i 's/LRI_Cal_Aux::destroy_lock_result(lock_Ds_result_add_map, Ds_result);/LRI_Cal_Aux::destroy_lock(lock_Ds_result_add_map); LRI_Cal_Aux::destroy_Ds_result(Ds_result);/' @BUILD@/hse-deps/libri/include/RI/ri/LRI-cal_loop3_GPU.hpp
# Accumulate into the existing local map, then apply fac_add_Ds once at the final merge.
sed -i 's/rDs_output.download(Ds_result, queue);/rDs_output.download(Ds_result_thread, queue);/g' @BUILD@/hse-deps/libri/include/RI/ri/LRI-cal_loop3_GPU.hpp
cmake -S @SOURCE@ -B @BUILD@ -G "Unix Makefiles" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=@INSTALL@ \
    -DCMAKE_CUDA_ARCHITECTURES=70 \
    -DENABLE_LIBRI_GPU=ON \
    -DDDLA_INCLUDE_DIR=@INSTALL@/ddla/include \
    -DDDLA_LIBRARY=@INSTALL@/ddla/lib/libddla.so \
    -DENABLE_LIBXC=ON -DENABLE_LIBRI=ON \
    -DLIBRI_DIR=@BUILD@/hse-deps/libri \
    -DLIBCOMM_DIR=@BUILD@/hse-deps/libcomm \
    -Dcereal_DIR=@BUILD@/hse-deps/cereal-install/lib/cmake/cereal \
    -DUSE_CUDA=ON \
    -DUSE_CUDA_MPI=ON \
    -DENABLE_CUSOLVERMP=ON \
    -DENABLE_CUBLASMP=ON \
    -DENABLE_NCCL_PARALLEL_DEVICE=ON \
    -DBUILD_TESTING=OFF \
    -DGIT_SUBMODULE=OFF 2>&1 | tee @RESULTS@/configure.log
cmake --build @BUILD@ --parallel 32 2>&1 | tee @RESULTS@/build.log
cmake --install @BUILD@ 2>&1 | tee @RESULTS@/install.log

@INSTALL@/bin/abacus --info | tee @RESULTS@/abacus-info.txt
ldd @INSTALL@/bin/abacus | tee @RESULTS@/ldd.txt
if grep -q 'not found' @RESULTS@/ldd.txt; then
    echo "ERROR: unresolved dynamic dependencies" >&2
    sed -n 's/.*not found.*/&/p' @RESULTS@/ldd.txt >&2
    exit 1
fi
cp @BUILD@/CMakeCache.txt @RESULTS@/CMakeCache.txt

mkdir -p "$HOME/abacus_hse_gpu_experiment/reuse/lcao"
cp @INSTALL@/bin/abacus "$HOME/abacus_hse_gpu_experiment/reuse/lcao/abacus"
cp -a @INSTALL@/ddla "$HOME/abacus_hse_gpu_experiment/reuse/lcao/"
exit 0
