INPUT_PARAMETERS
suffix            autotest
nbands            28

calculation       scf
ecutwfc           6
scf_thr           1.0e-7
scf_nmax          50
out_chg           0

smearing_method   gaussian
smearing_sigma    0.07

cal_force         1
cal_stress        1

mixing_type       broyden
mixing_beta       0.2
mixing_gg0        1.0

ks_solver         scalapack_gvx
basis_type        lcao
gamma_only        1
symmetry          0
nspin             2

#Parameter DFT+U with Yukawa potential (U/J calculated on the fly)
dft_plus_u        1
yukawa_potential  1
orbital_corr      2 2
onsite_radius     5.0
pseudo_dir        ../../PP_ORB
orbital_dir       ../../PP_ORB
