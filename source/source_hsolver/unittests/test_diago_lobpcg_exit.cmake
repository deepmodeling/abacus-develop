# Unit-level fatal-path checks. Run each in a fresh process/MPI job so that
# exit(1), the diagnostic and collective completion are checked together.
set(cases block dimension search dependent overlap_negative overlap_zero)
if(NOT ELPA_AVAILABLE)
  list(APPEND cases missing_backend)
endif()
if(NOT GPU)
  list(APPEND cases reused_invalid)
endif()
set(message_block "LOBPCG block must contain all requested bands")
set(message_dimension "The requested bands cannot form a full-rank LOBPCG space")
set(message_search "Nonfinite LOBPCG search direction")
set(message_dependent "overlap|HEGVX failed")
set(message_overlap_negative "overlap|HEGVX failed")
set(message_overlap_zero "overlap|HEGVX failed")
set(message_missing_backend "ELPA LOBPCG RR requires MPI and ELPA support")
set(message_reused_invalid "HEGVX failed")

foreach(case IN LISTS cases)
  # Entry failures precede locking; reuse after an actual solve covers both modes.
  set(locking_modes hard)
  if(case STREQUAL "reused_invalid")
    list(APPEND locking_modes soft)
  endif()
  foreach(locking IN LISTS locking_modes)
    set(directory "${OUTPUT_DIR}/${locking}_${case}")
    file(MAKE_DIRECTORY "${directory}")
    if(RANKS GREATER 1)
      set(command "${MPIEXEC}" "${MPI_NUMPROC_FLAG}" "${RANKS}" ${MPI_PREFLAGS}
                  "${BINARY}" --lobpcg-fatal "${case}" "${locking}" ${MPI_POSTFLAGS})
    else()
      set(command "${BINARY}" --lobpcg-fatal "${case}" "${locking}")
    endif()
    execute_process(COMMAND ${command} WORKING_DIRECTORY "${directory}"
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    file(WRITE "${directory}/output.log" "${output}\n${errors}")
    if(GPU AND "${result}" STREQUAL "77")
      message("SKIP: no usable GPU for LOBPCG exit checks")
      return()
    endif()
    if(NOT "${result}" STREQUAL "1")
      message(FATAL_ERROR "${locking}/${case}: expected exit 1, got ${result}; ${output}; ${errors}")
    endif()
    string(REGEX MATCHALL "${message_${case}}" matches "${output}")
    list(LENGTH matches count)
    if(count LESS RANKS)
      message(FATAL_ERROR "${locking}/${case}: expected diagnostic from ${RANKS} ranks, got ${count}; ${output}")
    endif()
    if(output MATCHES "Fatal LOBPCG test unexpectedly returned" OR errors MATCHES "terminate called|what\\(\\)")
      message(FATAL_ERROR "${locking}/${case}: did not exit through WARNING_QUIT")
    endif()
    message(STATUS "${locking}/${case}: exit 1, diagnostic on ${count} rank(s)")
  endforeach()
endforeach()
