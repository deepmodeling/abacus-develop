file(MAKE_DIRECTORY "${CASE_DIR}")
set(input_file "${CASE_DIR}/INPUT")
set(contents "INPUT_PARAMETERS\nbasis_type pw\nntype 1\n")
set(expected_exit 1)
set(expected_manual "input-main.html")

if(INPUT_CASE STREQUAL "missing_file")
  file(REMOVE "${input_file}")
  set(expected "Cannot open the INPUT file")
  set(expected_manual "")
elseif(INPUT_CASE STREQUAL "missing_header")
  set(contents "basis_type pw\nntype 1\n")
  set(expected "Missing INPUT_PARAMETERS header")
elseif(INPUT_CASE STREQUAL "unknown_parameter")
  string(APPEND contents "unknown_input_option 1\n")
  set(expected "Unknown INPUT parameter 'unknown_input_option'")
elseif(INPUT_CASE STREQUAL "duplicate_parameter")
  string(APPEND contents "nspin 1\nnspin 2\n")
  set(expected "The parameter nspin has been read twice")
  set(expected_manual "input-main.html#nspin")
elseif(INPUT_CASE STREQUAL "duplicate_string_eof")
  # Repeat a scalar string parameter with no value or final newline.
  string(APPEND contents "basis_type")
  set(expected "The parameter basis_type has been read twice")
  set(expected_manual "input-main.html#basis-type")
elseif(INPUT_CASE STREQUAL "invalid_value")
  string(APPEND contents "nspin 2abc\n")
  set(expected "Expected one Integer from {1, 2, 4}")
  set(expected_manual "input-main.html#nspin")
elseif(INPUT_CASE STREQUAL "invalid_dependency")
  string(APPEND contents "nspin 2\nnoncolin true\n")
  set(expected "Requires nspin==4")
  set(expected_manual "input-main.html#nspin")
elseif(INPUT_CASE STREQUAL "out_dmk_zero_precision")
  string(APPEND contents "out_dmk 1 0\n")
  set(expected "Invalid INPUT parameter 'out_dmk': precision must be a positive integer.")
  set(expected_manual "")
elseif(INPUT_CASE STREQUAL "out_hsk_zero_precision")
  string(APPEND contents "out_hsk 1 0\n")
  set(expected "Invalid INPUT parameter 'out_hsk': precision must be a positive integer.")
  set(expected_manual "")
elseif(INPUT_CASE STREQUAL "out_mat_tk_zero_precision")
  string(APPEND contents "out_mat_tk 1 0\n")
  set(expected "Invalid INPUT parameter 'out_mat_tk': precision must be a positive integer.")
  set(expected_manual "")
elseif(INPUT_CASE STREQUAL "valid")
  string(APPEND contents "nspin 2\n")
  set(expected_exit 0)
elseif(INPUT_CASE MATCHES "^dftu_alpha_")
  if(INPUT_CASE STREQUAL "dftu_alpha_below_zero")
    set(alpha "-0.1")
  elseif(INPUT_CASE STREQUAL "dftu_alpha_above_one")
    set(alpha "1.1")
  elseif(INPUT_CASE STREQUAL "dftu_alpha_nonfinite")
    set(alpha "nan")
  elseif(INPUT_CASE STREQUAL "dftu_alpha_trailing")
    set(alpha "0.5junk")
  else()
    message(FATAL_ERROR "Unknown invalid alpha test case: ${INPUT_CASE}")
  endif()
  string(APPEND contents "dftu_dc mixed\ndftu_alpha ${alpha}\n")
  set(expected "Invalid INPUT parameter 'dftu_alpha'")
  set(expected_manual "input-main.html#dftu-alpha")
elseif(INPUT_CASE MATCHES "^dftu_")
  set(contents "INPUT_PARAMETERS\nsuffix dftu_dc_bcast\nntype 1\nbasis_type lcao\nks_solver genelpa\ndft_functional PBE\nsymmetry 0\ndft_plus_u 1\norbital_corr 2\nhubbard_u 2\nnspin 2\necutwfc 100\n")
  if(INPUT_CASE STREQUAL "dftu_default")
    set(expected_dc "fll 1")
  elseif(INPUT_CASE STREQUAL "dftu_fll")
    string(APPEND contents "dftu_dc fll\n")
    set(expected_dc "fll 1")
  elseif(INPUT_CASE STREQUAL "dftu_amf")
    string(APPEND contents "dftu_dc amf\n")
    set(expected_dc "amf 1")
  elseif(INPUT_CASE STREQUAL "dftu_mixed0")
    string(APPEND contents "dftu_dc mixed\ndftu_alpha 0\n")
    set(expected_dc "mixed 0")
  elseif(INPUT_CASE STREQUAL "dftu_mixed05")
    string(APPEND contents "dftu_dc mixed\ndftu_alpha 0.5\n")
    set(expected_dc "mixed 0.5")
  elseif(INPUT_CASE STREQUAL "dftu_mixed1")
    string(APPEND contents "dftu_dc mixed\ndftu_alpha 1\n")
    set(expected_dc "mixed 1")
  else()
    message(FATAL_ERROR "Unknown DFT+U INPUT test case: ${INPUT_CASE}")
  endif()
  set(expected_exit 0)
else()
  message(FATAL_ERROR "Unknown INPUT test case: ${INPUT_CASE}")
endif()

if(NOT INPUT_CASE STREQUAL "missing_file")
  file(WRITE "${input_file}" "${contents}")
endif()

execute_process(
  COMMAND "${MPIEXEC_EXECUTABLE}" ${MPIEXEC_NUMPROC_FLAG} 4 ${MPIEXEC_PREFLAGS}
          "${READER}" ${MPIEXEC_POSTFLAGS} "${input_file}"
  WORKING_DIRECTORY "${CASE_DIR}"
  RESULT_VARIABLE result
  OUTPUT_VARIABLE output
  ERROR_VARIABLE error
  TIMEOUT 30)
string(APPEND output "${error}")

if(NOT "${result}" STREQUAL "${expected_exit}")
  message(
    FATAL_ERROR "Expected exit ${expected_exit}, got ${result}:\n${output}")
endif()
string(REGEX MATCHALL "INPUT reader process reached shutdown" exits "${output}")
list(LENGTH exits exit_count)
if(NOT exit_count EQUAL 4)
  message(
    FATAL_ERROR
      "Only ${exit_count} of 4 processes reached reader shutdown:\n${output}")
endif()
if(expected_exit EQUAL 1)
  foreach(diagnostic IN ITEMS "${input_file}" "${expected}"
                              "${expected_manual}")
    string(FIND "${output}" "${diagnostic}" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "Missing diagnostic '${diagnostic}':\n${output}")
    endif()
  endforeach()
endif()
if(DEFINED expected_dc)
  string(REGEX MATCHALL "DFTU DC received: ${expected_dc}[\r\n]" received "${output}")
  list(LENGTH received received_count)
  if(NOT received_count EQUAL 4)
    message(FATAL_ERROR "Only ${received_count} of 4 ranks received ${expected_dc}:\n${output}")
  endif()
endif()
