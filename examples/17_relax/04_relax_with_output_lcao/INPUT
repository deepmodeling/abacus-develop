out_eband            1    # eband_kin/vl/vnl/hart/vxc*.txt per written ionic step (g{step} in mode 2)
out_mat_xc           1    # MAT/vxcmok{ki}s{spin}g{step}_nao.txt (KS-orbital repr.)
out_mat_xc2          1    # MAT/vxcrs{spin}_nao.csr (NAO repr., final snapshot; same H(R)-style CSR layout)
out_xc_r             1    # CHG/xc_rho_s{spin}.cube, xc_vrho_s{spin}.cube, xc_exc.cube, xc_sigma_*.cube, xc_vsigma_*.cube; full cube header, (g{step} in mode 2)

out_freq_ion         2
