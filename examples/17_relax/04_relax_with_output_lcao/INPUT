INPUT_PARAMETERS
#Parameters    (General)
suffix               out_app_flag0
nbands               8
calculation          cell-relax
ecutwfc              10
scf_nmax             20
basis_type           lcao
relax_nmax           5
cal_stress           1
stress_thr           1e-6
cal_force            1
force_thr_ev         1.0e-3
ks_solver            scalapack_gvx
mixing_type          broyden
mixing_beta          0.7
relax_method         cg_trad
pseudo_dir           ../../../tests/PP_ORB
orbital_dir          ../../../tests/PP_ORB
nspin                2
gamma_only           0

# Output layout convention (applies to every out_ parameter below):
#   out_app_flag=2: per-step files are routed into SUB/ directories with a g{step} suffix
#                   (MAT/ CHG/ POT/ PSI/ DOS/ BANDS/ ELF/ STRUC/); final-snapshot outputs
#                   (ldos, vxcrs) keep only the latest frame and drop g{step}.
#   out_app_flag=0: fixed filenames in OUT.${suffix}/, truncated on every write (no SUB/, no g{step}).
#   out_app_flag=1: fixed filenames in OUT.${suffix}/, frames appended and separated by '# Ionic_Step N'.
#   Files that stay in OUT.${suffix}/ even in mode 2: eband_*.txt, eig_occg{step}.txt,
#                   mullikeng{step}.txt, pbands{spin}g{last}.xml, nao.txt, logs/info/restart files.
#   The 'SUB/' prefixes below describe mode 2; in mode 0/1 the same content lands in OUT.${suffix}/.
#   Every written frame carries a provenance header: text files open with '# ABACUS version: ...'
#                   and '# Written at ...' lines, CSR files append them to the 'Ionic_Step N'
#                   line, and cube files inline them on the first comment line.
#   The k-space MAT/*.txt matrices (dmk, hk, sk, tk, vnlk, vlk, vhk, vxck) share one
#                   self-describing layout: metadata block, UnitCell lattice block,
#                   flat matrix body (no 'Row N' markers).

out_element_info     1    # OUT.{element_label}/ (pseudopotential + orbital files)

out_stru             1    # mode0: STRU_NOW + STRU_FINAL; mode1: STRU_NOW + STRU_FINAL + STRU (appended); mode2: STRUC/STRU_NOW + STRUC/STRU_FINAL + STRUC/STRU{step}

out_chg              1    # CHG/chgs{spin}g{step}.cube
out_pot              1    # POT/pots{spin}g{step}.cube
out_wfc_lcao         1    # PSI/wf{ki}s{spin}g{step}_nao.txt (多 k); wfs{spin}g{step}_nao.txt (gamma-only)

out_dos              1    # DOS/doss{spin}g{step}.txt, pdoss{spin}g{step}.txt
out_ldos             1    # DOS/ldos_{bias}ev.cube (final snapshot; header records the final step)
out_band             1    # BANDS/bands{spin}g{step}.txt (nspin=2 → bands1*, bands2*)

out_elf              1    # ELF/elfs{spin}g{step}.cube, ELF/elftotg{step}.cube (mode 0/1: elfs{spin}.cube, elftot.cube in OUT.${suffix})
out_mul              1    # mulliken.txt (mode 0/1), mullikeng{step}.txt (mode 2)

out_dmk              1    # MAT/dmk{ki}s{spin}g{step}_nao.txt (多 k); dms{spin}g{step}_nao.txt (gamma-only)
out_dmr              1    # MAT/dmrs{spin}g{step}_nao.csr
out_hsk              1    # MAT/hk{ki}s{spin}g{step}_nao.txt, sk{ki}g{step}_nao.txt
out_hsr              1    # MAT/hrs{spin}g{step}_nao.csr, srg{step}_nao.csr
out_mat_ds           1    # MAT/dsrxg{step}_nao.csr, dsryg{step}_nao.csr, dsrzg{step}_nao.csr (spin-independent)
out_mat_l            1    # MAT/lxg{step}_nao.csr, lyg{step}_nao.csr, lzg{step}_nao.csr (H(R)-style CSR;
                          # imaginary part only, the NAO basis is real; not supported for nspin=4)
out_mat_r            1    # MAT/rrxg{step}_nao.csr, rryg{step}_nao.csr, rrzg{step}_nao.csr (three components)
out_mat_t            1    # MAT/trg{step}_nao.csr (spin-independent)
out_mat_tk           1    # MAT/tk{ki}g{step}_nao.txt (T(k), spin-independent)

out_mat_h_t          1    # MAT/tk{ki}g{step}_nao.txt (legacy alias of out_mat_tk)
out_mat_h_vnl        1    # MAT/vnlk{ki}g{step}_nao.txt (spin-independent)
out_mat_h_vl         1    # MAT/vlk{ki}g{step}_nao.txt (spin-independent)
out_mat_h_vh         1    # MAT/vhk{ki}g{step}_nao.txt (spin-independent)
out_mat_h_vxc        1    # MAT/vxck{ki}s{spin}g{step}_nao.txt (spin-dependent)

out_proj_band        1    # pbands{spin}.xml (mode 0/1), pbands{spin}g{last}.xml (mode 2); final snapshot only
